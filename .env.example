# ==========================================
# Hello Farmer Environment Variables (.env)
# ==========================================

# -----------------
# Core AI & Providers
# -----------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

STT_PROVIDER=gemini
TTS_PROVIDER=edge_tts
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
WEATHER_PROVIDER=open_meteo
SMS_PROVIDER=mock

# -----------------
# Telephony & AudioSocket
# -----------------
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092
ASTERISK_SIP_PASSWORD=ChangeThisSecretInProduction123!
BARGE_IN_ENABLED=false
MAX_CALL_DURATION_SECONDS=600
INITIAL_SILENCE_TIMEOUT_SECONDS=10
SPEECH_SILENCE_TIMEOUT_MS=1000

# -----------------
# Database & Cache
# -----------------
POSTGRES_USER=farmer
POSTGRES_PASSWORD=farmerpass
POSTGRES_DB=hello_farmer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://farmer:farmerpass@postgres:5432/hello_farmer

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -----------------
# Security & Privacy
# -----------------
SECRET_KEY=hello_farmer_insecure_dev_secret_change_me_32chars!
PHONE_ENCRYPTION_KEY=D7L2j61X01c90wPZq8c1BvK7x8k1D2M4N6P8Q0R2S4T=
SALT_HASH_SECRET=hello_farmer_caller_hash_salt_12345

# -----------------
# Application Limits & Settings
# -----------------
CONCURRENCY_LIMIT=2
CALLER_RATE_LIMIT_PER_DAY=10
SIMILARITY_THRESHOLD=0.65
LOG_LEVEL=INFO
